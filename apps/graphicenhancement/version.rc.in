#include <windows.h>
#include "graphicenhancement-resource.h"
IDI_GRAPHICENHANCEMENT ICON "graphicenhancement.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "GraphicEnhancement Video Player"
   VALUE "FileVersion", "@GRAPHICENHANCEMENT_DISPLAY_VERSION@"
   VALUE "ProductName", "GraphicEnhancement"
   VALUE "ProductVersion", "@GRAPHICENHANCEMENT_DISPLAY_VERSION@"
   VALUE "OriginalFilename", "@GRAPHICENHANCEMENT_RESOURCE_FILENAME@"
   VALUE "LegalCopyright", "GraphicEnhancement contributors. GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
